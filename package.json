{
  "name": "yt-downloader",
  "version": "1.0.0",
  "description": "Simple YouTube video downloader for Ubuntu",
  "main": "main.js",

  "author": {
    "name": "Usman Arshad",
    "email": "usman.arshad.dev@gmail.com"
  },

  "homepage": "https://github.com/usmanarshad/yt-downloader",

  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "electron . --no-sandbox",
    "build": "electron-builder"
  },

  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.0"
  },

  "build": {
    "appId": "com.ytdownloader.app",
    "productName": "YT Downloader",
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "icon": "assets/icon.png"
    }
  }
}